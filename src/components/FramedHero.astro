---
// Inner-page hero: footage in a camera frame with the H1 running into it.
import Cam from './Cam.astro';
interface Props {
  crumbs: { name: string; href?: string }[];
  loc?: string;
  k: string;
  label: string;
  info?: string;
  title: string; // HTML allowed (<br>)
  small?: boolean;
  lede: string;
  cta: { label: string; href: string };
  cta2?: { label: string; href: string };
  aria: string;
}
const { crumbs, loc = 'Milton Keynes · UK-wide', k, label, info, title, small = false, lede, cta, cta2, aria } = Astro.props;
---
<section class="fh" data-hero aria-label={aria}>
  <div class="fh-top gut">
    <nav class="crumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => <><li aria-hidden="true">/</li><li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li></>)}
      </ol>
    </nav>
    <span class="s-loc"><i aria-hidden="true"></i>{loc}</span>
  </div>
  <div class="fh-stage gut">
    <Cam k={k} label={label} tcOff={0} info={info} caption={false} class="fh-cam" />
    <h1 class:list={['fh-h1', { sm: small }]} set:html={title} />
  </div>
  <div class="fh-low gut">
    <p>{lede}</p>
    <div class="ctas"><a class="btn" href={cta.href}>{cta.label}</a>{cta2 && <a class="btn-ghost" href={cta2.href}>{cta2.label}</a>}</div>
  </div>
</section>
