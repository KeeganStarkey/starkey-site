---
import Base from '../layouts/Base.astro';
import '../styles/inner.css';
---
<Base title="No signal | Starkey Productions" description="This page doesn't exist." noindex enquireHref="/#enquire" mbar="">
  <section class="ph-head gut" aria-labelledby="nf-h" style="padding-bottom:clamp(90px,12vw,170px)">
    <div class="bars" aria-hidden="true">
      <i style="background:#c0c0c0"></i><i style="background:#c0c000"></i><i style="background:#00c0c0"></i><i style="background:#00c000"></i><i style="background:#c000c0"></i><i style="background:#c00000"></i><i style="background:#0000c0"></i>
      <span>No signal · 404</span>
    </div>
    <h1 id="nf-h" style="margin-top:clamp(28px,4vw,48px)">Lost the feed.</h1>
    <p class="lede">The page you're after doesn't exist, or it's been moved. Everything worth watching is one click away.</p>
    <div class="ctas" style="margin-top:36px"><a class="btn" href="/">Back to home</a><a class="btn-ghost" href="/work/">See the work</a></div>
  </section>
</Base>
<style>
  .bars{position:relative; display:grid; grid-template-columns:repeat(7,1fr); height:clamp(120px,22vw,260px); max-width:900px; filter:saturate(.8) brightness(.85)}
  .bars i{display:block; animation:flick 4s steps(1) infinite}
  .bars span{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); padding:10px 14px; background:#000; font:500 12px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; white-space:nowrap}
  @keyframes flick{0%,96%{opacity:1} 97%{opacity:.6} 98%{opacity:1}}
  @media (prefers-reduced-motion: reduce){ .bars i{animation:none} }
</style>
