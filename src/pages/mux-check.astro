---
// Temporary page: plays every Mux upload so Keegan can say which film is which.
// Not linked anywhere, not in the sitemap, noindex. Delete once the IDs are mapped in src/data/videos.ts.
import Base from '../layouts/Base.astro';
import '../styles/inner.css';

const ids = [
  'vExMuR0102ZieQrbHTLI9571J5aHhgMzbkgisZSiie6bc',
  '2NzL2q00Rk7XpAkNvU8653oZ02Gz00clJXXo5mGK49dqps',
  '4LQMEYECtb02KvSOTd1rLNBbEnDzac801QvMaWafluS01M',
  'g9aboas7024P78d00ZXL012bdLmQqZK1s6kalicFL39PLk',
  'QflHc1tEH01YCnz9AATWmP007MSpsLdlY27GacO01101zvE',
  'mHHfGFWOtDj00FOXXoQvFwPmg8FVrxhH7ZSyZF6OyYGw',
  'jgnFZNUQ6zSebd1jlBR1tZ9zEOEnhOaFXrgTjpb78mc',
  'r9xAiyIqBXHzhj84MEgSpuiG7sTyVRBcUTBaWQ5W7WM',
  'i2JuUZf8W1dezkz2ig8BL6pKD58keObthrB500x01E5GA',
  'RPPzOtlg5OUz2v5N6lu95Wb5lacexZABQswrnFNzfIA',
];
---
<Base title="Mux check | Starkey Productions" description="Internal check page." noindex enquireHref="/#enquire" mbar="">
  <section class="ph-head gut" aria-labelledby="mc-h">
    <h1 id="mc-h">Mux check</h1>
    <p class="lede">Your 10 uploads, numbered. Tell Claude what each one is. Shape and length are read from the video itself.</p>
  </section>
  <section class="gut" style="padding-block:clamp(40px,6vw,80px) clamp(80px,10vw,140px)">
    <ol class="mc-grid">
      {ids.map((id, i) => (
        <li class="mc">
          <div class="mc-v"><video controls muted playsinline preload="metadata" data-mc={id} poster={`https://image.mux.com/${id}/thumbnail.webp?width=640&time=2`}></video></div>
          <div class="mc-meta">
            <span class="mc-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="mc-s" data-status>Loading…</span>
          </div>
          <code class="mc-id">{id}</code>
        </li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .mc-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr)); gap:40px 24px; list-style:none; padding:0}
  .mc{display:grid; gap:12px; align-content:start; min-width:0}
  .mc-v{background:#151615; aspect-ratio:16/9; display:grid; place-items:center; overflow:hidden}
  .mc-v video{width:100%; height:100%; object-fit:contain; background:#000}
  .mc-meta{display:flex; justify-content:space-between; align-items:baseline; gap:12px}
  .mc-n{font-family:var(--display); font-stretch:62%; font-weight:850; font-size:44px; line-height:1}
  .mc-s{font:500 11px/1.4 var(--mono); letter-spacing:.12em; text-transform:uppercase; color:var(--fg-2); text-align:right}
  .mc-s.bad{color:var(--rec)}
  .mc-id{font:400 11px/1.4 var(--mono); color:var(--dim); overflow-wrap:anywhere}
</style>
<script>
  import { attach } from '../scripts/footage';
  document.querySelectorAll<HTMLVideoElement>('video[data-mc]').forEach((v) => {
    const st = v.closest('.mc')!.querySelector<HTMLElement>('[data-status]')!;
    v.addEventListener('loadedmetadata', () => {
      const w = v.videoWidth, h = v.videoHeight, r = w / h;
      const shape = r > 2 ? 'Scope 2.39:1' : r > 1.2 ? 'Landscape' : r < 0.85 ? 'Portrait' : 'Square';
      const m = Math.floor(v.duration / 60), s = Math.round(v.duration % 60);
      st.textContent = `${shape} · ${w}×${h} · ${m}:${String(s).padStart(2, '0')}`;
    });
    v.addEventListener('error', () => { st.textContent = 'Not playing: check this ID'; st.classList.add('bad'); });
    attach(v, v.dataset.mc, undefined, { full: true });
  });
</script>
